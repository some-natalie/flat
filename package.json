{
  "name": "flat",
  "version": "3.4.0",
  "description": "The GitHub action which powers data fetching for Flat",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "package": "ncc build --source-map --license LICENSE --target es2023 lib/main.js",
    "package-post": "ncc build --target es2023 lib/post.js -o dist/post",
    "dist": "npm run build && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run package && npm run package-post && node scripts/licenses.mjs",
    "format": "prettier --write \"src/**/*.ts\" \"scripts/*.mjs\" \"tests/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"scripts/*.mjs\" \"tests/*.mjs\"",
    "test": "npm run build && node --test lib/*.test.js lib/backends/*.test.js",
    "test:bundle": "node --test tests/bundle.test.mjs",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githubocto/flat.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/githubocto/flat/issues"
  },
  "homepage": "https://github.com/githubocto/flat#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "axios": "^1.20.0",
    "connection-string": "^5.0.0",
    "csv-stringify": "^6.9.0",
    "mssql": "^12.7.4",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "sql.js": "^1.14.2",
    "typeorm": "^1.1.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/mssql": "^12.3.0",
    "@types/pg": "^8.23.1",
    "@types/sql.js": "^1.4.11",
    "@vercel/ncc": "^0.45.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "volta": {
    "node": "24.21.0"
  }
}
